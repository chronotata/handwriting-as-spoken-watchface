# Pebble build output — regenerate with `pebble build`
build/

# Node
node_modules/

# Windows download markers, picked up when dragging files in via WSL
*:Zone.Identifier

# Python
__pycache__/
*.pyc

# OS noise
.DS_Store
Thumbs.db

# Local one-way sync helper (git folder -> build folder). Machine-specific
# absolute paths are baked into it, so it is deliberately not shared.
tools/sync.sh

# Throwaway layout previews - not part of the project
preview_*.png

# Emulator screenshots from tools/date_sweep.sh. Regenerated on demand, and
# a set per typeface per reading mode adds up fast.
shots/

# Rendered screenshots from tools/mock_sweep.py. Same reasoning, and these
# take two seconds to rebuild.
shots-mock/
