# Line endings.
#
# The repo is stored with LF. Without this file, editing on Windows turns every
# saved file CRLF and git reports all of them as fully rewritten - which buries
# real changes under whole-file churn.
#
# `text=auto` normalises to LF on commit while leaving the working copy in
# whatever your editor and core.autocrlf produce, so nothing needs converting
# by hand.
* text=auto

# Generated by tools/tune.py, which writes LF regardless of platform.
src/c/geometry.h text eol=lf
package.json     text eol=lf

# Never touch these.
*.png binary
*.ttf binary
*.pbi binary
*.pbw binary
